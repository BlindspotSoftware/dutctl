# Add dutagent user
u dutagent - "dutagent user" /var/lib/dutagent
# Add dutagent group
g dutagent -
# Add user to the group
m dutagent dutagent

# Access to serial
m dutagent uucp
m dutagent dialout

# Access to flasher
m dutagent plugdev

# Access to GPIO (Raspberry Pi /dev/gpiomem)
# Ensure the gpio group exists, then add dutagent to it
g gpio -
m dutagent gpio
